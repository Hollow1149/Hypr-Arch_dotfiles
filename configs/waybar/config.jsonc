{
  "layer": "top",
  "position": "top",
  "height": 32,
  "reload_style_on_change": true,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window",
    "custom/privacy_dots"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/screen_rec_indicator",
    "group/players",
    "group/wireless",
    "group/volume",
    "group/hardware",
    "custom/notification"
  ],
  "hyprland/workspaces": {
    "format": "<span size='13pt'><b>{icon}</b></span>",
    "on-click": "activate",
    "sort-by-number": true,
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十",
      "magic": "特"
    },
    "show-special": true
  },
  "mpris": {
    "format": "<span font=\"Font Awesome 7 Free\">{player_icon}</span> {title}",
    "format-paused": "<span font=\"Font Awesome 7 Free\">{status_icon}</span> {title}",
    "max-length": 20,
    "dynamic-len": 0,
    "player-icons": {
      "default": "<b></b>",
      "vlc": "<span color='#E85E00'><b>󰕼</b></span>",
      "mpv": "<b></b>",
      "firefox": ""
    },
    "status-icons": {
      "paused": "",
      "playing": "",
      "stopped": ""
    },
    "ignored-players": [
      "mpd"
    ]
  },
  "mpd": {
    "format": "<span font=\"Font Awesome 7 Free\"><b>{stateIcon}</b></span> {title}",
    "format-disconnected": "",
    "format-stopped": "<span font=\"Font Awesome 7 Free\"><b>  </b></span>",
    "max-length": 20,
    "interval": 10,
    "state-icons": {
      "paused": "",
      "playing": ""
    },
    "on-click": "mpc toggle",
    "on-click-right": "mpc stop",
    "on-scroll-up": "mpc prev",
    "on-scroll-down": "mpc next",
    "tooltip-format": "{title} {artist}"
  },
  "clock": {
    "interval": 60,
    "format": "<span size='11pt' font=\"Orbitron Bold\"><b>{:%H : %M}</b></span>",
    "format-alt": "<span><b>{:%A, %B %d, %Y (%R)}</b></span>",
    // "format-alt": "{:%A, %B %d, %Y (%R)}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "tray": {
    "icon-size": 13,
    "spacing": 8
  },
  "cpu": {
    "interval": 10,
    "format": "<span font=\"Font Awesome 7 Free\"><b></b></span> {usage}%",
    "max-length": 10
  },
  "memory": {
    "interval": 10,
    "format": "<span font=\"Font Awesome 7 Free\"><b></b></span> {used:0.1f} GB"
  },
  "pulseaudio": {
    "format": "<span font=\"Font Awesome 7 Free\"><b>{icon}</b></span> {volume}%{format_source}",
    "format-bluetooth": "{volume}% <span font=\"Font Awesome 7 Free\"><b>{icon}</b></span>",
    "format-muted": "<span font=\"Font Awesome 7 Free\"><b></b></span> 0%{format_source}",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        "",
        ""
      ]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "ignored-sinks": [
      "Easy Effects Sink"
    ],
    "format-source": "",
    "format-source-muted": ""
  },
  "hyprland/window": {
    "format": "{initialClass}: {title}",
    "max-length": 25,
    "icon": false
  },
  "battery": {
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span size='12pt' font=\"Material Icons\"><b>{icon}</b></span> {capacity}%",
    "format-charging": "<span size='12pt' font=\"Material Icons\"><b>{icon}</b></span> {capacity}%",
    "format-plugged": "<span size='12pt' font=\"Material Icons\"><b>󰂄</b></span> {capacity}%",
    "format-icons": {
      "default": [
        "󰂎",
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ],
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ]
    },
    "max-length": 10
  },
  "network": {
    "format": "{ifname}",
    "format-wifi": "<span font=\"Material Icons\"><b>{icon}</b></span> {essid}",
    "format-ethernet": "<span font=\"Font Awesome 7 Free\"><b></b></span> {ipaddr}/{cidr}/{gwaddr}",
    "format-disconnected": "",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} ({gwaddr}) ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ]
  },
  "bluetooth": {
    "format": "<span font=\"Font Awesome 7 Free\"><b>{icon}</b></span> {status}",
    "format-connected": "<span font=\"Font Awesome 7 Free\"><b>{icon}</b></span> {device_alias}",
    "format-connected-battery": "<span font=\"Font Awesome 7 Free\"><b>{icon}</b></span> {device_alias} {device_battery_percentage}%",
    // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
    "tooltip-format": "{controller_alias} {controller_address}\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias} {controller_address}\n{num_connections} connected\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias} {device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} {device_address} {device_battery_percentage}%",
    "format-icons": ""
  },
  "backlight": {
    "tooltip": false,
    "format": "<span font=\"Material Icons\"><b>{icon}</b></span> {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃝",
      "󰃠"
    ]
  },
  "group/players": {
    "orientation": "horizontal",
    "modules": [
      "mpris",
      "mpd"
    ]
  },
  "group/hardware": {
    "orientation": "horizontal",
    "modules": [
      "battery",
      "backlight",
      "cpu",
      "memory"
    ],
    "drawer": {
      "transition-duration": 400
    }
  },
  "group/wireless": {
    "orientation": "horizontal",
    "modules": [
      "tray",
      "network",
      "bluetooth"
    ],
    "drawer": {
      "transition-duration": 400,
      "click-to-reveal": true
    }
  },
  "group/volume": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "pulseaudio/slider"
    ],
    "drawer": {
      "transition-duration": 400
    }
  },
  "custom/privacy_dots": {
    "exec": "$HOME/.config/waybar/scripts/privacydots.sh",
    "return-type": "json",
    "interval": 3,
    "format": "{text}",
    "tooltip": true,
    "escape": false,
    "markup": "pango"
  },
  "custom/screen_rec_indicator": {
    "on-click": "$HOME/.local/bin/myScripts/screenshots/screenrecord.sh",
    "exec": "$HOME/.local/bin/myScripts/screenshots/screen_recording.sh",
    "signal": 8,
    "return-type": "json"
  },
  "custom/notification": {
    "tooltip": true,
    "format": "<span font=\"Material Icons\"><b>{icon}</b></span>",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
