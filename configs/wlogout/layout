{
  "label": "lock",
  "action": "sleep 0.25 && hyprlock",
  "text": "[L]ock",
  "keybind": "l"
}
 {
  "label": "shutdown",
  "action": "sleep 0.25 && hyprshutdown -t 'Shutting Down...' --post-cmd 'shutdown -P 0' ",
  "text": "[S]hutdown",
  "keybind": "s"
}
 {
  "label": "logout",
  "action": "sleep 0.25 && hyprshutdown --vt 2",
  "text": "L[o]gout",
  "keybind": "o"
}
 {
  "label": "reboot",
  "action": "sleep 0.25 && hyprshutdown -t 'Rebooting...' --post-cmd 'reboot'",
  "text": "[R]eboot",
  "keybind": "r"
}
 {
  "label": "sleep",
  "action": "notify-send -u normal 'Sleep Not Supported Yet.' 'On Your Nvidia GPU' ",
  "text": "Slee[p]",
  "keybind": "p"
}
